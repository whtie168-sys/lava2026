#define Tep_SCREEN_WIDTH ([UIScreen mainScreen].bounds.size.width)

#define Tep_SCREEN_HEIGHT ([UIScreen mainScreen].bounds.size.height)

#define Tep_IS_iPhoneX [UIScreen mainScreen].bounds.size.height >= 812.f

#define Tep_StatusBarHeight (Tep_IS_iPhoneX ? 44.f : 20.f)

#define Tep_NavBarHeight (44.f+Tep_StatusBarHeight)

#define Tep_TabbarSafeBottomMargin (Tep_IS_iPhoneX ? 34.f : 0.f)

#define Tep_TabBarHeight (Tep_IS_iPhoneX ? (49.f+34.f) : 49.f)


#define Color_HEX(rgbValue, a) \
    [UIColor colorWithRed:((CGFloat)((rgbValue & 0xFF0000) >> 16)) / 255.0 \
                    green:((CGFloat)((rgbValue & 0xFF00) >> 8)) / 255.0 \
                     blue:((CGFloat)(rgbValue & 0xFF)) / 255.0 \
                    alpha:(a)]




#define WeakSelf(type)  __weak typeof(type) weak##type = type;

#define arriveVCName(name) [[UIStoryboard storyboardWithName:name bundle:nil] instantiateInitialViewController]



